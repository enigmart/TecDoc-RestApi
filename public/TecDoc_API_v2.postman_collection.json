	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set base URL if not set",
					"if (!pm.environment.get('base_url')) {",
					"    pm.environment.set('base_url', 'http://koupkastecdoc.gr/tecdoc-api/public/api');",
					"}",
					"",
					"// Check if token exists and is not expired",
					"const token = pm.environment.get('api_token');",
					"const expiresAt = pm.environment.get('token_expires_at');",
					"",
					"if (!token || token === '') {",
					"    console.warn('⚠️ API Token not set. Please run \"Create Token\" first.');",
					"}",
					"",
					"if (expiresAt && new Date(expiresAt) < new Date()) {",
					"    console.warn('⚠️ API Token expired. Please refresh or create new token.');",
					"}",
					"",
					"// Set common headers",
					"pm.request.headers.add({",
					"    key: 'Accept',",
					"    value: 'application/json'",
					"});",
					"",
					"pm.request.headers.add({",
					"    key: 'User-Agent',",
					"    value: 'TecDoc-Postman-Client/1.0'",
					"});",
					"",
					"// Add timestamp for tracking",
					"pm.globals.set('request_timestamp', new Date().toISOString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Calculate response time",
					"const responseTime = pm.response.responseTime;",
					"const requestTime = pm.globals.get('request_timestamp');",
					"",
					"// Basic response validation",
					"pm.test('✅ Status code is successful', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
					"});",
					"",
					"pm.test('✅ Response time is acceptable', function () {",
					"    pm.expect(responseTime).to.be.below(5000); // 5 seconds max",
					"});",
					"",
					"pm.test('✅ Response has JSON content-type', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"});",
					"",
					"// API-specific tests",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    pm.test('✅ Response has success field', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('success');",
					"        pm.expect(jsonData.success).to.be.true;",
					"    });",
					"",
					"    pm.test('✅ Response structure is valid', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('data');",
					"    });",
					"",
					"    // Check for API version info",
					"    const jsonData = pm.response.json();",
					"    if (jsonData.api_info) {",
					"        pm.test('✅ API version is correct', function () {",
					"            pm.expect(jsonData.api_info).to.have.property('version');",
					"            pm.expect(jsonData.api_info.version).to.eql('2.0');",
					"        });",
					"    }",
					"}",
					"",
					"// Rate limiting monitoring",
					"const rateLimitLimit = pm.response.headers.get('X-RateLimit-Limit');",
					"const rateLimitRemaining = pm.response.headers.get('X-RateLimit-Remaining');",
					"const rateLimitReset = pm.response.headers.get('X-RateLimit-Reset');",
					"",
					"if (rateLimitRemaining) {",
					"    pm.test('✅ Rate limit info available', function () {",
					"        pm.expect(parseInt(rateLimitRemaining)).to.be.greaterThan(0);",
					"    });",
					"    ",
					"    console.log(`📊 Rate Limit: ${rateLimitRemaining}/${rateLimitLimit} remaining`);",
					"    ",
					"    // Warn if rate limit is low",
					"    if (parseInt(rateLimitRemaining) < 50) {",
					"        console.warn('⚠️ Rate limit is low!');",
					"    }",
					"}",
					"",
					"// Cache headers validation",
					"const cacheControl = pm.response.headers.get('Cache-Control');",
					"const etag = pm.response.headers.get('ETag');",
					"",
					"if (cacheControl || etag) {",
					"    console.log('🚀 Cache headers present - responses are cacheable');",
					"}",
					"",
					"// Performance logging",
					"if (responseTime < 100) {",
					"    console.log(`🚀 Excellent response time: ${responseTime}ms`);",
					"} else if (responseTime < 500) {",
					"    console.log(`⚡ Good response time: ${responseTime}ms`);",
					"} else if (responseTime < 1000) {",
					"    console.log(`⏱️ Acceptable response time: ${responseTime}ms`);",
					"} else {",
					"    console.warn(`⚠️ Slow response time: ${responseTime}ms`);",
					"}",
					"",
					"// Error handling",
					"if (pm.response.code >= 400) {",
					"    const errorData = pm.response.json();",
					"    console.error('❌ Request failed:', errorData.message || 'Unknown error');",
					"    ",
					"    if (pm.response.code === 401) {",
					"        console.error('🔐 Authentication failed - check your token');",
					"    } else if (pm.response.code === 429) {",
					"        console.error('⏰ Rate limit exceeded - please wait');",
					"    }",
					"}"
				]
			}
		}
	],
