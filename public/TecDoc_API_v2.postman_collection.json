{
	"info": {
		"_postman_id": "tecdoc-api-v2-collection",
		"name": "TecDoc API v2",
		"description": "Complete collection for TecDoc API v2 with authentication, vehicle data, and article search endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "tecdoc-api"
	},
	"item": [
		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Create Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Save token to environment variable",
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('api_token', response.data.token);",
									"    pm.environment.set('token_expires_at', response.data.expires_at);",
									"    console.log('Token saved:', response.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Postman Test Token\",\n  \"scopes\": [\"read\", \"write\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/v2/auth/create-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v2",
								"auth",
								"create-token"
							]
						},
						"description": "Create a new API authentication token with 30 days expiration"
					},
					"response": []
				},
				{
					"name": "Token Info",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/v2/auth/token-info",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v2",
								"auth",
								"token-info"
							]
						},
						"description": "Get information about your current token including usage statistics"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/v2/auth/refresh-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v2",
								"auth",
								"refresh-token"
							]
						},
						"description": "Refresh token expiration (extend by 30 days) and reset usage counter"
					},
					"response": []
				},
				{
					"name": "Revoke Token",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{api_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/v2/auth/revoke-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v2",
								"auth",
								"revoke-token"
							]
						},
						"description": "Permanently revoke the current token"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for token management"
		},
		{
			"name": "🔧 Enhanced Article Details",
			"item": [
				{
					"name": "Get Enhanced Article Details",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Set sample article ID if not provided",
									"if (!pm.environment.get('article_id') || pm.environment.get('article_id') === '') {",
									"    pm.environment.set('article_id', '102225');",
									"    console.log('🔧 Using sample article ID: 102225');",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Enhanced Article Details Tests",
									"pm.test('✅ Response is successful', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('✅ Response has enhanced structure', function () {",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson).to.have.property('success', true);",
									"    pm.expect(responseJson).to.have.property('data');",
									"    ",
									"    const data = responseJson.data;",
									"    pm.expect(data).to.have.property('basic_info');",
									"    pm.expect(data).to.have.property('specifications');",
									"    pm.expect(data).to.have.property('media');",
									"    pm.expect(data).to.have.property('replacements');",
									"});",
									"",
									"pm.test('✅ Basic info contains required fields', function () {",
									"    const responseJson = pm.response.json();",
									"    const basicInfo = responseJson.data.basic_info;",
									"    ",
									"    pm.expect(basicInfo).to.have.property('ART_ID');",
									"    pm.expect(basicInfo).to.have.property('ART_ARTICLE_NR');",
									"    pm.expect(basicInfo).to.have.property('ART_SUP_BRAND');",
									"    pm.expect(basicInfo).to.have.property('ART_CTM');",
									"    ",
									"    console.log('📋 Article Number:', basicInfo.ART_ARTICLE_NR);",
									"    console.log('🏭 Brand:', basicInfo.ART_SUP_BRAND);",
									"});",
									"",
									"pm.test('✅ Specifications array exists', function () {",
									"    const responseJson = pm.response.json();",
									"    const specs = responseJson.data.specifications;",
									"    ",
									"    pm.expect(specs).to.be.an('array');",
									"    console.log('🔧 Specifications count:', specs.length);",
									"    ",
									"    if (specs.length > 0) {",
									"        pm.expect(specs[0]).to.have.property('criteria_id');",
									"        pm.expect(specs[0]).to.have.property('value');",
									"        console.log('🔧 First specification:', specs[0]);",
									"    }",
									"});",
									"",
									"pm.test('✅ Media array exists', function () {",
									"    const responseJson = pm.response.json();",
									"    const media = responseJson.data.media;",
									"    ",
									"    pm.expect(media).to.be.an('array');",
									"    console.log('📷 Media files count:', media.length);",
									"    ",
									"    if (media.length > 0) {",
									"        pm.expect(media[0]).to.have.property('filename');",
									"        pm.expect(media[0]).to.have.property('type');",
									"        console.log('📷 First media file:', media[0].filename);",
									"    }",
									"});",
									"",
									"pm.test('✅ Performance metrics available', function () {",
									"    const responseJson = pm.response.json();",
									"    const performance = responseJson.performance;",
									"    ",
									"    pm.expect(performance).to.have.property('query_time_ms');",
									"    pm.expect(performance).to.have.property('cached');",
									"    ",
									"    console.log('⚡ Query time:', performance.query_time_ms + 'ms');",
									"    console.log('💾 Cached:', performance.cached);",
									"    ",
									"    // Performance warning if slow",
									"    if (performance.query_time_ms > 100) {",
									"        console.warn('⚠️ Query time is above 100ms');",
									"    }",
									"});",
									"",
									"pm.test('✅ No authentication required', function () {",
									"    // This endpoint should work without token",
									"    pm.expect(pm.response.code).to.not.equal(401);",
									"    console.log('🔓 Public endpoint works without authentication');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/articles/{{article_id}}/details",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"articles",
								"{{article_id}}",
								"details"
							]
						},
						"description": "Get comprehensive article details including specifications, media, and replacement information from multiple database tables. This endpoint provides much more information than the standard v2 article details endpoint.\n\n**Features:**\n- No authentication required\n- Complete article information\n- Technical specifications\n- Media files and images\n- Replacement/superseded information\n- Performance metrics\n- Fast cached responses\n\n**Database Tables Used:**\n- ARTICLES (basic info)\n- ARTICLE_CRITERIA (specifications)\n- ART_MEDIA_INFO (images/media)\n- SUPERSEDED_ARTICLES (replacements)"
					},
					"response": []
				},
				{
					"name": "Get Enhanced Details with EAN Barcode",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test article details with EAN barcode",
									"pm.test(' Article details retrieved successfully', function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"    pm.expect(response.data).to.have.property('basic_info');",
									"    pm.expect(response.data).to.have.property('specifications');",
									"    pm.expect(response.data).to.have.property('media');",
									"    pm.expect(response.data).to.have.property('replacements');",
									"});",
									"",
									"pm.test(' EAN Barcode is included', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data.basic_info).to.have.property('BARCODE_EAN');",
									"    if (response.data.basic_info.BARCODE_EAN) {",
									"        console.log('EAN Barcode:', response.data.basic_info.BARCODE_EAN);",
									"    }",
									"});",
									"",
									"pm.test(' Specifications have proper names', function () {",
									"    const response = pm.response.json();",
									"    if (response.data.specifications.length > 0) {",
									"        const spec = response.data.specifications[0];",
									"        pm.expect(spec).to.have.property('criteria_name');",
									"        pm.expect(spec).to.have.property('criteria_type');",
									"        console.log('Sample specification:', spec.criteria_name, '=', spec.value);",
									"    }",
									"});",
									"",
									"pm.test(' Performance metrics included', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('performance');",
									"    pm.expect(response.performance).to.have.property('query_time_ms');",
									"    console.log('Query time:', response.performance.query_time_ms + 'ms');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/articles/102261/details",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"articles",
								"102261",
								"details"
							]
						},
						"description": "Get enhanced article details including EAN barcode, specifications with proper names, media info, and replacement data. Sample article 102261 (code: 00.42) has EAN: 5904157343445"
					},
					"response": []
				},
				{
					"name": "Test EAN Barcode Search",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test EAN barcode search functionality",
									"pm.test('✅ EAN barcode search works', function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"});",
									"",
									"pm.test('✅ Article found by EAN', function () {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.length > 0) {",
									"        const article = response.data[0];",
									"        pm.expect(article).to.have.property('ART_ID');",
									"        pm.expect(article).to.have.property('ART_ARTICLE_NR');",
									"        pm.expect(article).to.have.property('BARCODE_EAN');",
									"        console.log('Found article:', article.ART_ARTICLE_NR, 'with EAN:', article.BARCODE_EAN);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"search_term\": \"5904157343445\",\n  \"search_type\": \"ean\",\n  \"per_page\": 10\n}"
						},
						"url": {
							"raw": "{{base_url}}/optimized-search/search-articles",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"optimized-search",
								"search-articles"
							]
						},
						"description": "Search for articles using EAN barcode. This test uses the known EAN 5904157343445 for article 102261 (code: 00.42)"
					},
					"response": []
				}
			]
